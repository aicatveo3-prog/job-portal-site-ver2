# ============================================================
# 장애인 채용공고 자동화 사이트 Ver2 - 환경 설정 (.env 로 복사해 사용)
# ============================================================

# 1. OpenCode Go 모델 설정 (DeepSeek 4.1)
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
# OpenCode AI 정제 활성화 (true / false)
ENABLE_AI=true
# 한 번에 AI로 묶어 처리할 공고 개수 (4~6 권장)
AI_BATCH_SIZE=5
# 1회 실행당 사이트별 최대 수집 개수
MAX_PER_SOURCE=25

# 2. 웹사이트 공개 URL (나중에 GitHub Pages 연결 시 입력 → 알림 버튼 링크로 사용)
SITE_PUBLIC_URL=

# 3. Git 자동 푸시 (GitHub 저장소 연결 후 true 로 바꾸면 매일 자동 배포!)
AUTO_GIT_PUSH=false

# 4. Windows 바탕화면 토스트 알림 (true / false)
ENABLE_WINDOWS_TOAST=true

# 5. 카카오톡 "나에게 보내기" 알림 (python scripts/setup_kakao.py 로 1회 설정)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 6. 선택: 디스코드 웹훅 알림 (비워두면 미사용)
DISCORD_WEBHOOK_URL=

# 7. 선택: 텔레그램 봇 알림 (비워두면 미사용)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
